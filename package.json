{
  "name": "scoutfox-ai-browser-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous AI Browser Agent for Local & Cloud LLMs (Ollama, OpenRouter, AgentRouter, Gemini, OpenAI, Claude, Groq, NVIDIA NIM).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\" \"tests/**/*.test.ts\"",
    "check:tests": "node scripts/checkTestCount.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/content && tsc --noEmit -p tests",
    "test:e2e": "node tests/e2e/smoke.mjs --build",
    "test:e2e:mock": "node tests/e2e/smoke.mjs --mock --build",
    "click-lab": "node tests/e2e/click-lab.mjs",
    "test:replay": "node tests/e2e/replay-real.mjs",
    "check": "for f in content/*.js sidepanel/*.js; do node --check \"$f\" || exit 1; done",
    "build": "node scripts/build.mjs",
    "evalscan": "node scripts/evalscan.mjs",
    "zip": "node scripts/zip.mjs"
  },
  "author": "Prit Dhanani (preetdhanani)",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/node": "22.20.4",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@langchain/anthropic": "1.5.11",
    "@langchain/core": "1.2.13",
    "@langchain/google-genai": "2.3.2",
    "@langchain/langgraph": "1.4.18",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/ollama": "1.3.0",
    "@langchain/openai": "1.6.0",
    "9router": "0.5.104",
    "parse5": "8.0.1"
  },
  "overrides": {
    "@langchain/core": "$@langchain/core"
  }
}
